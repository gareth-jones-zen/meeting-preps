<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test code builds JSON records freely; nothing here is published with AOT. -->
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MeetingPreps\MeetingPreps.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\tools\Parity\ScenarioRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
